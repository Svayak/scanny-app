# Kopiera till .env och fyll i dina värden
# LADDA ALDRIG UPP .env till GitHub!

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/scanny
JWT_SECRET=byt-ut-detta-till-nagot-hemligt-och-langt-123
ADMIN_SECRET=byt-ut-detta-till-din-hemliga-admin-kod
PORT=3001

# Central e-post via Azure Communication Services.
# Lämna tomt om varje verkstad ska använda sin egen SMTP.
# EMAIL_FROM är den verifierade avsändaradressen, t.ex. noreply@scanny.se.
# Visningsnamnet Scanny sätts på avsändaren i Azure.
# EMAIL_REPLY_TO är valfri.
ACS_EMAIL_CONNECTION_STRING=
EMAIL_FROM=
EMAIL_REPLY_TO=
