# Kopiera till .env och fyll i dina värden
# LADDA ALDRIG UPP .env till GitHub!

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/scanny
JWT_SECRET=byt-ut-detta-till-nagot-hemligt-och-langt-123
ADMIN_SECRET=byt-ut-detta-till-din-hemliga-admin-kod
PORT=3001

# Central e-post. Verkstadens egen SMTP (användarnamn + lösenord) vinner alltid.
# 2) Central SMTP om SMTP_HOST, SMTP_USER och SMTP_PASSWORD alla är satta.
#    Google Workspace: logga in som nils@altitudmedia.se och skicka som alias noreply@.
#    Port 587 = STARTTLS. Port 465 = implicit TLS.
#    EMAIL_FROM_NAME är visningsnamnet (standard Scanny). Ingen Reply-To: lämna EMAIL_REPLY_TO tom.
#    SMTP_PASSWORD är ett applösenord och får aldrig committas.
# 3) Annars Azure Communication Services, om anslutningssträng och EMAIL_FROM båda är satta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nils@altitudmedia.se
SMTP_PASSWORD=
EMAIL_FROM=noreply@altitudmedia.se
EMAIL_FROM_NAME=Scanny
EMAIL_REPLY_TO=
ACS_EMAIL_CONNECTION_STRING=
